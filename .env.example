# Copy this file to .env and fill in real values for local development.
# .env is gitignored - never commit it.

# --- General -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- NGINX ---------------------------------------------------------------
# Host port that proxies to the internal NGINX gateway on :80.
NGINX_PORT=8080

# --- PostgreSQL ------------------------------------------------------------
# Used by the postgres container itself and by the core service to build
# its connection string. Services connect via the "postgres" hostname on
# the Compose network - never localhost.
POSTGRES_USER=nool
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nool_core

# --- Firebase (Auth service) ---------------------------------------------
# Required for /ready and token verification to succeed. Leave blank for a
# clean `docker compose up --build` without real Firebase credentials -
# health/readiness for other checks still work, but token verification
# will fail until these are set.
FIREBASE_PROJECT_ID=
# Host path to an Admin SDK service account JSON (Firebase Console ->
# Project Settings -> Service Accounts -> Generate new private key).
# Bind-mounted read-only into auth/core - see compose.yml. Put the file
# under ./secrets/ (gitignored) and never commit it.
FIREBASE_CREDENTIALS_HOST_PATH=./secrets/firebase-service-account.json
# Web API key (Firebase Console -> Project Settings -> General -> Your
# apps -> Web API Key). Public by design - the same value each frontend
# already ships as NEXT_PUBLIC_FIREBASE_API_KEY - but also needed here
# now that POST /api/v1/login checks passwords server-side.
FIREBASE_WEB_API_KEY=

# --- Observability ---------------------------------------------------------
# Jaeger trace UI host port (compose.override.yml, local dev only) - see
# docs/OBSERVABILITY.md. Optional; defaults to 16686 if unset.
JAEGER_UI_PORT_HOST=16686

# --- Direct service access (compose.override.yml, local dev only) --------
# Host ports for reaching auth/core/kg directly, bypassing NGINX - useful
# for hitting each service's OpenAPI/Swagger UI at /docs. Not published in
# the production-shaped compose.yml. Optional; default to 8001/8002/8003 if
# unset.
AUTH_PORT_HOST=8001
CORE_PORT_HOST=8002
KG_PORT_HOST=8003
COLEARNER_PORT_HOST=8004

# --- Knowledge Graph service (kg) -----------------------------------------
# The kg service is the only thing that talks to nool-kg directly - see
# services/kg/src/services/nool_kg_client.py. nool-kg is a separate,
# already-deployed service (FalkorDB-backed); this container never runs it
# locally, just calls its REST API.
NOOL_KG_BASE_URL=https://nool-data.draco-labs.in
# OpenAI API key used by the kg service to generate questions grounded in
# the knowledge graph - see services/kg/src/services/generator.py. Also
# used by the colearner service (realtime voice and the Bloom grader) -
# both containers read this same value.
OPENAI_API_KEY=

# AI gateway (LiteLLM proxy, compose service `litellm`): non-voice OpenAI calls go
# through it with their metadata and it keeps each call's cost (UI :4000/ui).
# LITELLM_MASTER_KEY signs in to the UI; the per-service keys come from
# POST /key/generate (see litellm/config.yaml). Leave LLM_GATEWAY_URL empty to
# call OpenAI directly.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LLM_GATEWAY_KEY_GENERATION=
LLM_GATEWAY_KEY_KG=
LLM_GATEWAY_KEY_COLEARNER=

# --- Voice Co-Learner service (colearner) ---------------------------------
# Firebase-authenticated - see FIREBASE_PROJECT_ID/FIREBASE_CREDENTIALS_HOST_PATH
# above (shared with auth/core). Model choice per pipeline is fixed in code,
# not configurable - see services/colearner/README.md. It only needs
# OPENAI_API_KEY (set above).

# Question images (dataset_questions.figures) - see scripts/upload_assets.py.
# Blank = local Azurite from compose.override.yml. For Azure, set the storage
# account's connection string and its container's public base URL.
AZURE_STORAGE_CONNECTION_STRING=
ASSET_BASE_URL=

# --- AI spend budget (optional) --------------------------------------------
# Monthly AI budget in INR, shown against this month's spend and projection
# on the Super Admin's AI usage view (GET /api/v1/admin/ai-usage/summary).
# Blank = no budget.
AI_MONTHLY_BUDGET_INR=
