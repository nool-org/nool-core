# Production .env template for compose.yml + compose.prod.yml - see
# docs/DEPLOY_HOSTINGER.md. On the server:
#   cp .env.production.example .env && chmod 600 .env
# then fill in every [SECRET] and every example.in value. .env is gitignored -
# never commit it, never paste it into chat/tickets.
#
# Legend:  [SECRET] = credential, keep out of git/screenshots/logs
#          [CHANGE] = differs from dev / must be your real value

# --- Compose -----------------------------------------------------------
# Makes a plain `docker compose ...` in this directory mean production, so
# dev's compose.override.yml (open DB/service ports) can never be started
# here by accident. Add ",kg-local" to the profiles to run nool-kg locally.
COMPOSE_FILE=compose.yml:compose.prod.yml
COMPOSE_PROFILES=admin

# --- General -----------------------------------------------------------
# [CHANGE] also hard-disables the colearner playground
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Public hostnames + TLS (Caddy, caddy/Caddyfile) -------------------
# Each needs a DNS A record -> the server's IP BEFORE first start, or
# Let's Encrypt issuance fails (Caddy retries, but with backoff).
# [CHANGE] app + admin consoles call this
API_DOMAIN=api.example.in
# [CHANGE]
SCHOOL_ADMIN_DOMAIN=schooladmin.example.in
# [CHANGE]
SUPER_ADMIN_DOMAIN=admin.example.in
# [CHANGE] Let's Encrypt expiry/problem notices
ACME_EMAIL=ops@example.in

# --- NGINX (internal gateway behind Caddy) ----------------------------
# Browser origins allowed by CORS - the two admin consoles. Space or comma
# separated, full https:// origins. The Android app sends no Origin, so it
# needs no entry. Never "*" in production.
# [CHANGE]
NGINX_CORS_ORIGINS=https://schooladmin.example.in https://admin.example.in
# Per-client-IP rate limits (defaults shown). A whole school may share one
# NAT IP - raise NGINX_API_RATE if a full class gets 429s.
NGINX_API_RATE=30r/s
NGINX_API_BURST=60
NGINX_AUTH_RATE=10r/m
NGINX_AUTH_BURST=10

# --- PostgreSQL (Docker on the VPS for the pilot) ---------------------
# Later step: managed PostgreSQL (CLAUDE.md "Production Database") - see
# docs/DEPLOY_HOSTINGER.md "Later: managed PostgreSQL".
POSTGRES_USER=nool
# [SECRET] long random: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
POSTGRES_DB=nool_core

# --- Backups (backup service, scripts/backup.sh) ----------------------
# 21:00 UTC = 02:30 IST
BACKUP_HOUR_UTC=21
# on-server copies; off-server copies via rclone cron (runbook)
BACKUP_KEEP_DAYS=7

# --- Firebase (PRODUCTION project, e.g. noolai-prod - never the dev one) --
# [CHANGE]
FIREBASE_PROJECT_ID=noolai-prod
# [SECRET] file, chmod 600
FIREBASE_CREDENTIALS_HOST_PATH=./secrets/firebase-service-account.json
# Web API key - public by design (ships in the app), but restrict it to the
# Identity Toolkit + Token Service APIs in Google Cloud Console.
# [CHANGE]
FIREBASE_WEB_API_KEY=

# --- OpenAI (kg, generation, colearner) -------------------------------
# [SECRET] a production key with a monthly budget limit
OPENAI_API_KEY=
GENERATION_MODEL=gpt-5.1
VERIFY_MODEL=gpt-5-mini

# --- Textbook graph (nool-kg) -----------------------------------------
# Hosted nool-kg. To run it on this server instead, use --profile kg-local
# (needs the nool-kg image + FalkorDB - see the nool-kg repo) and set
# http://nool-kg:8000 here.
NOOL_KG_BASE_URL=https://nool-data.draco-labs.in
# [SECRET] if the nool-kg instance requires one
NOOL_KG_API_KEY=
# Only for --profile kg-local:
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
# [SECRET]
FALKORDB_PASSWORD=

# --- Question images (Azure Blob Storage) -----------------------------
# Dev uses azurite (compose.override.yml); production a real storage account.
# The connection string is only used by scripts/upload_assets.py (run from
# an operator machine); ASSET_BASE_URL is the container's public URL that
# core hands to clients.
# [SECRET]
AZURE_STORAGE_CONNECTION_STRING=
# [CHANGE]
ASSET_BASE_URL=https://<account>.blob.core.windows.net/question-assets

# --- AI spend budget (optional) ----------------------------------------
# Monthly AI budget in INR, shown against this month's spend and projection
# on the Super Admin's AI usage view. Blank = no budget.
AI_MONTHLY_BUDGET_INR=

# --- Observability ------------------------------------------------------
# Jaeger runs internal-only (no host port); view it over an SSH tunnel -
# see docs/DEPLOY_HOSTINGER.md. Caps its in-memory trace store.
JAEGER_MAX_TRACES=20000

# Not used in production (dev-only, compose.override.yml): NGINX_PORT,
# *_PORT_HOST, JAEGER_UI_PORT_HOST, AZURITE_*, PLAYGROUND_ENABLED.
